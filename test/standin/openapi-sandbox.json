  "/simulate/transactions": {
   "post": {
    "operationId": "SimulateTransaction",
    "requestBody": {
     "content": {
      "application/json": {
       "examples": {
        "Authorization with defaults": {
         "value": {
          "amount": 4500,
          "cardId": "24c4f90d-ab3b-4f6e-8a1d-d251a4fcf34c",
          "type": "authorization"
         }
        },
        "Settlement first, custom merchant": {
         "value": {
          "amount": 12990,
          "cardId": "24c4f90d-ab3b-4f6e-8a1d-d251a4fcf34c",
          "currency": "GBP",
          "dateTime": "2026-10-14T09:30:00Z",
          "merchant": {
           "city": "LONDON",
           "country": "GBR",
           "mcc": "5812",
           "name": "PRET A MANGER"
          },
          "type": "settlement"
         }
        }
       },
       "schema": {
        "$ref": "#/components/schemas/simulate-transaction-request"
       }
      }
     },
     "required": true
    },
    "responses": {
     "202": {
      "content": {

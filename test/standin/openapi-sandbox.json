  "/card-subscriptions/{subscriptionId}": {
   "delete": {
    "operationId": "DeleteCardSubscription",
    "responses": {
     "204": {
      "$ref": "#/components/responses/no-content"
     },
     "400": {
      "$ref": "#/components/responses/bad-request"
     },

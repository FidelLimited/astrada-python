    "type": "object"
   },
   "validation-problem-item": {
    "properties": {
     "detail": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "title",
     "detail"
    ],
    "type": "object"
   }
  }

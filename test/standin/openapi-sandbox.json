     },
     "newCardCount": {
      "default": 0,
      "maximum": 20,
      "minimum": 0,
      "type": "integer"
     },
     "transactionsPerCard": {
      "default": 3,
      "maximum": 10,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "networkReference"
    ],
    "type": "object"
   },

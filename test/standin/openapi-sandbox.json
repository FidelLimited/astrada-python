    "requestBody": {
     "content": {
      "application/json": {
       "examples": {
        "Simulate Transaction Scenario Request Example": {
         "value": {
          "amount": 1500,
          "cardId": "24c4f90d-ab3b-4f6e-8a1d-d251a4fcf34c",
          "currency": "USD",
          "scenario": "simple_purchase",
          "subaccountId": "f297d659-c13d-4219-aeaa-e10a845140a5"
         }
        }
       },
       "schema": {
        "$ref": "#/components/schemas/simulate-transaction-scenario-request"
       }
      }
     },
     "required": true
    },
    "responses": {
     "202": {
      "content": {
       "application/json": {
        "examples": {
         "Example Simulate Transaction Scenario Response": {
          "value": {
           "transactions": [
            {
             "messageIds": [
              "9b2e6c4a-1f3d-4e8b-9a7c-2d5f8e1b4c6a",
              "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d"
             ]
